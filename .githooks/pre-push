#!/bin/sh
# Refuses force-pushes to and deletion of the protected branch.
#
# GitHub's own branch protection is unavailable on private repos under a free
# org plan, so this stands in for it. It is client-side, so it only guards the
# machines that have it enabled, and `--no-verify` bypasses it deliberately -
# it is here to stop accidents, not a determined push.
#
# Enable in a fresh clone with:  git config core.hooksPath .githooks

PROTECTED="${PROTECTED_BRANCH:-main}"
ZERO=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        "refs/heads/$PROTECTED") ;;
        *) continue ;;
    esac

    if [ "$local_sha" = "$ZERO" ]; then
        echo "pre-push: refusing to delete $PROTECTED on the remote." >&2
        status=1
        continue
    fi

    # A brand-new remote branch has nothing to clobber.
    [ "$remote_sha" = "$ZERO" ] && continue

    # Fast-forward means the remote tip is already an ancestor of what we push.
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "pre-push: refusing a non-fast-forward push to $PROTECTED." >&2
        echo "  remote is at $(git rev-parse --short "$remote_sha" 2>/dev/null || echo "$remote_sha")," >&2
        echo "  which is not an ancestor of what you are pushing." >&2
        echo "  Rebase onto origin/$PROTECTED, or pass --no-verify if this is deliberate." >&2
        status=1
    fi
done

exit $status
